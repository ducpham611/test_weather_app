<?xml version="1.0" encoding="utf-8"?>
<!-- Used for the current-weather card when the animated background is on.
     A dark translucent panel keeps white text readable over every one of
     Breezy's gradients, including the pale "clear day" and "cloudy" ones. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <solid android:color="#66000000" />
</shape>
