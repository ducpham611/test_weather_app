    <!-- Giới thiệu -->
    <string name="about">Giới thiệu</string>
    <string name="version_format">Phiên bản %1$s</string>
    <string name="about_body">Dữ liệu thời tiết lấy từ Open-Meteo, dùng mô hình ECMWF IFS HRES – mô hình toàn cầu độ phân giải 9 km, cập nhật 6 giờ một lần.\n\nDữ liệu được cấp phép theo CC BY 4.0. Gói miễn phí của Open-Meteo chỉ dành cho mục đích phi thương mại.\n\nMàu nền thời tiết lấy từ Breezy Weather (ui-weather-view), dùng theo giấy phép GNU LGPL v3.\n\nBiểu tượng thời tiết do Google thiết kế, lấy từ bộ google-weather-icons của mrdarrengriffin.</string>
    <string name="open_meteo_website">Mở Open-Meteo.com</string>

