<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Holder for the animated weather background (Breezy Weather,
         LGPL-3.0). MaterialWeatherView only has a (Context) constructor, so
         it cannot be inflated from XML and is added in code. Hidden until the
         setting turns it on, so the plain background stays the default. -->
    <FrameLayout
        android:id="@+id/weatherBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stateListAnimator="@null"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <ProgressBar
                    android:id="@+id/progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="48dp"
                    android:visibility="gone" />

                <!-- Error state -->
                <LinearLayout
                    android:id="@+id/errorGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="15sp"
                        android:textColor="?android:attr/textColorSecondary" />

                    <Button
                        android:id="@+id/buttonRetry"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/retry" />
                </LinearLayout>

                <!-- Main content -->
                <LinearLayout
                    android:id="@+id/contentGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Current weather: white rounded card -->
                    <LinearLayout
                        android:id="@+id/currentCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_card_surface"
                        android:elevation="2dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="20dp">

                        <LinearLayout
                            android:id="@+id/headerCity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:background="?attr/selectableItemBackground"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp">

                            <TextView
                                android:id="@+id/textCityName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:textSize="22sp"
                                android:textColor="?android:attr/textColorPrimary" />

                            <TextView
                                android:id="@+id/textCitySubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:textSize="13sp"
                                android:textColor="?android:attr/textColorSecondary" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imageCurrentIcon"
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:layout_marginTop="8dp"
                            android:contentDescription="@string/weather_icon" />

                        <TextView
                            android:id="@+id/textTemperature"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:maxLines="1"
                            android:textSize="56sp"
                            android:textColor="?android:attr/textColorPrimary" />

                        <TextView
                            android:id="@+id/textCondition"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_horizontal"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"
                            android:textSize="16sp"
                            android:textColor="?android:attr/textColorPrimary" />

                        <TextView
                            android:id="@+id/textFeelsLike"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center_horizontal"
                            android:textSize="13sp"
                            android:textColor="?android:attr/textColorSecondary" />

                        <TextView
                            android:id="@+id/textUpdatedAt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_horizontal"
                            android:textSize="12sp"
                            android:textColor="?android:attr/textColorSecondary" />
                    </LinearLayout>

                    <!-- Detail row: blue rounded card -->
                    <LinearLayout
                        android:id="@+id/detailRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_card_blue"
                        android:elevation="2dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <LinearLayout style="@style/DetailCell">
                            <TextView style="@style/DetailLabel" android:text="@string/humidity" />
                            <TextView
                                android:id="@+id/textHumidity"
                                style="@style/DetailValue"
                                android:drawableStart="@drawable/ic_detail_humidity"
                                android:drawablePadding="6dp" />
                        </LinearLayout>

                        <LinearLayout style="@style/DetailCell">
                            <TextView style="@style/DetailLabel" android:text="@string/wind" />
                            <TextView
                                android:id="@+id/textWind"
                                style="@style/DetailValue"
                                android:drawableStart="@drawable/ic_detail_wind"
                                android:drawablePadding="6dp" />
                        </LinearLayout>

                        <LinearLayout style="@style/DetailCell">
                            <TextView style="@style/DetailLabel" android:text="@string/precipitation" />
                            <TextView
                                android:id="@+id/textPrecipitation"
                                style="@style/DetailValue"
                                android:drawableStart="@drawable/ic_detail_rain"
                                android:drawablePadding="6dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Everything below the two cards keeps an opaque
                         background, so the animation never sits behind small
                         grey text. -->
                    <LinearLayout
                        android:id="@+id/lowerContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp"
                        android:paddingBottom="8dp">

                    <!-- Hourly -->
                    <TextView
                        style="@style/SectionTitle"
                        android:text="@string/hourly_title" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerHourly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="96dp"
                        android:clipToPadding="false"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:overScrollMode="never" />

                    <!-- Daily, with Min / Max column headers -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorSecondary"
                            android:text="@string/daily_title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="40dp"
                            android:gravity="end"
                            android:maxLines="1"
                            android:textSize="13sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:text="@string/temp_min" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="44dp"
                            android:gravity="end"
                            android:maxLines="1"
                            android:textSize="13sp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:text="@string/temp_max" />
                    </LinearLayout>

                    <!-- Plain container, not a RecyclerView: the section has to
                         grow with its content so the page scrolls as one piece
                         and every expanded day is visible. -->
                    <LinearLayout
                        android:id="@+id/dailyContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />

                    <!-- A TextView, not a Button. Under a MaterialComponents
                         theme <Button> inflates as MaterialButton, which ignores
                         android:background and keeps its own blue fill, leaving
                         blue text on blue. -->
                    <TextView
                        android:id="@+id/buttonShowMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:elevation="2dp"
                        android:minHeight="44dp"
                        android:gravity="center"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:textAllCaps="true"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/sky_blue"
                        android:text="@string/show_more" />

                    <TextView
                        android:id="@+id/textAttribution"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textSize="11sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:text="@string/attribution" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
