<?xml version="1.0" encoding="utf-8"?>
<!-- The root carries the static weather gradient (set in code) and reaches
     behind the transparent status bar; fitsSystemWindows keeps the content
     itself clear of the system bars. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_default"
    android:fitsSystemWindows="true"
    app:statusBarBackground="@android:color/transparent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:stateListAnimator="@null"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight"
            app:titleTextColor="@color/on_glass_primary"
            app:title="@string/app_name" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="16dp">

                <ProgressBar
                    android:id="@+id/progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="48dp"
                    android:visibility="gone" />

                <!-- Error state -->
                <LinearLayout
                    android:id="@+id/errorGroup"
                    style="@style/GlassBlock"
                    android:gravity="center"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textError"
                        style="@style/OnGlass"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/buttonRetry"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/on_glass_primary"
                        app:strokeColor="@color/on_glass_primary"
                        android:text="@string/retry" />
                </LinearLayout>

                <!-- Main content: four identical see-through blocks -->
                <LinearLayout
                    android:id="@+id/contentGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- 1. Current weather -->
                    <LinearLayout
                        android:id="@+id/currentCard"
                        style="@style/GlassBlock"
                        android:layout_marginTop="4dp"
                        android:gravity="center_horizontal"
                        android:paddingBottom="18dp">

                        <LinearLayout
                            android:id="@+id/headerCity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:background="?attr/selectableItemBackground"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp">

                            <TextView
                                android:id="@+id/textCityName"
                                style="@style/OnGlass"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:textSize="22sp" />

                            <TextView
                                android:id="@+id/textCitySubtitle"
                                style="@style/OnGlass.Secondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imageCurrentIcon"
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:layout_marginTop="8dp"
                            android:contentDescription="@string/weather_icon" />

                        <TextView
                            android:id="@+id/textTemperature"
                            style="@style/OnGlass"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:maxLines="1"
                            android:textSize="56sp" />

                        <TextView
                            android:id="@+id/textCondition"
                            style="@style/OnGlass"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_horizontal"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/textFeelsLike"
                            style="@style/OnGlass.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center_horizontal"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/textUpdatedAt"
                            style="@style/OnGlass.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_horizontal"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- 2. Humidity / wind / rain -->
                    <LinearLayout
                        android:id="@+id/detailRow"
                        style="@style/GlassBlock"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <LinearLayout style="@style/DetailCell">
                            <TextView style="@style/DetailLabel" android:text="@string/humidity" />
                            <TextView
                                android:id="@+id/textHumidity"
                                style="@style/DetailValue"
                                android:drawableStart="@drawable/ic_detail_humidity"
                                android:drawablePadding="6dp" />
                        </LinearLayout>

                        <LinearLayout style="@style/DetailCell">
                            <TextView style="@style/DetailLabel" android:text="@string/wind" />
                            <TextView
                                android:id="@+id/textWind"
                                style="@style/DetailValue"
                                android:drawableStart="@drawable/ic_detail_wind"
                                android:drawablePadding="6dp" />
                        </LinearLayout>

                        <LinearLayout style="@style/DetailCell">
                            <TextView style="@style/DetailLabel" android:text="@string/precipitation" />
                            <TextView
                                android:id="@+id/textPrecipitation"
                                style="@style/DetailValue"
                                android:drawableStart="@drawable/ic_detail_rain"
                                android:drawablePadding="6dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 3. Next 24 hours -->
                    <LinearLayout
                        android:id="@+id/hourlyBlock"
                        style="@style/GlassBlock">

                        <TextView
                            style="@style/GlassTitle"
                            android:text="@string/hourly_title" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerHourly"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="96dp"
                            android:clipToPadding="false"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:overScrollMode="never" />
                    </LinearLayout>

                    <!-- 4. Upcoming days, with Min / Max column headers -->
                    <LinearLayout
                        android:id="@+id/dailyBlock"
                        style="@style/GlassBlock">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="2dp">

                            <TextView
                                style="@style/OnGlass.Secondary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:text="@string/daily_title" />

                            <TextView
                                style="@style/OnGlass.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="40dp"
                                android:gravity="end"
                                android:maxLines="1"
                                android:textSize="13sp"
                                android:text="@string/temp_min" />

                            <TextView
                                style="@style/OnGlass.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="44dp"
                                android:gravity="end"
                                android:maxLines="1"
                                android:textSize="13sp"
                                android:text="@string/temp_max" />
                        </LinearLayout>

                        <!-- Plain container, not a RecyclerView: the section has to
                             grow with its content so the page scrolls as one piece
                             and every expanded day is visible. -->
                        <LinearLayout
                            android:id="@+id/dailyContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp" />

                        <!-- A TextView, not a Button. Under a MaterialComponents
                             theme <Button> inflates as MaterialButton, which ignores
                             android:background and keeps its own blue fill. -->
                        <TextView
                            android:id="@+id/buttonShowMore"
                            style="@style/OnGlass"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_glass_pill"
                            android:clickable="true"
                            android:focusable="true"
                            android:minHeight="44dp"
                            android:gravity="center"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:textAllCaps="true"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:text="@string/show_more" />
                    </LinearLayout>

                    <!-- Air quality (WAQI) block. Hidden until the first result arrives. -->
                    <LinearLayout
                        android:id="@+id/aqiBlock"
                        style="@style/GlassBlock"
                        android:visibility="gone">

                        <TextView
                            style="@style/GlassTitle"
                            android:text="@string/aqi_title" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <!-- No token / unavailable / loading. -->
                            <TextView
                                android:id="@+id/textAqiMessage"
                                style="@style/OnGlass.Secondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textSize="13sp"
                                android:visibility="gone" />

                            <LinearLayout
                                android:id="@+id/aqiContent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:baselineAligned="false"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/textAqiValue"
                                        style="@style/OnGlass"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-light"
                                        android:includeFontPadding="false"
                                        android:maxLines="1"
                                        android:textSize="46sp" />

                                    <!-- Wrapper so a long label wraps instead of
                                         pushing past the card at large font sizes. -->
                                    <FrameLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:layout_marginStart="14dp">

                                        <TextView
                                            android:id="@+id/textAqiBadge"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:maxLines="2"
                                            android:paddingStart="12dp"
                                            android:paddingEnd="12dp"
                                            android:paddingTop="5dp"
                                            android:paddingBottom="5dp"
                                            android:textColor="@color/badge_text_light"
                                            android:textSize="14sp"
                                            android:textStyle="bold" />
                                    </FrameLayout>
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/textAqiAdvice"
                                    style="@style/OnGlass.Secondary"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:lineSpacingExtra="2dp"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/textAqiDetail"
                                    style="@style/OnGlass.Secondary"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:lineSpacingExtra="2dp"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <!-- Credit line. Required by the data source's terms. -->
                            <TextView
                                android:id="@+id/textAqiSource"
                                style="@style/OnGlass.Secondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="?attr/selectableItemBackground"
                                android:minHeight="32dp"
                                android:gravity="center_vertical"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- UV index (uvindexapi.com) block. Hidden until the first result arrives. -->
                    <LinearLayout
                        android:id="@+id/uvBlock"
                        style="@style/GlassBlock"
                        android:visibility="gone">

                        <TextView
                            style="@style/GlassTitle"
                            android:text="@string/uv_title" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <!-- No token / unavailable / loading. -->
                            <TextView
                                android:id="@+id/textUvMessage"
                                style="@style/OnGlass.Secondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textSize="13sp"
                                android:visibility="gone" />

                            <LinearLayout
                                android:id="@+id/uvContent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:baselineAligned="false"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/textUvValue"
                                        style="@style/OnGlass"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-light"
                                        android:includeFontPadding="false"
                                        android:maxLines="1"
                                        android:textSize="46sp" />

                                    <!-- Wrapper so a long label wraps instead of
                                         pushing past the card at large font sizes. -->
                                    <FrameLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:layout_marginStart="14dp">

                                        <TextView
                                            android:id="@+id/textUvBadge"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:maxLines="2"
                                            android:paddingStart="12dp"
                                            android:paddingEnd="12dp"
                                            android:paddingTop="5dp"
                                            android:paddingBottom="5dp"
                                            android:textColor="@color/badge_text_light"
                                            android:textSize="14sp"
                                            android:textStyle="bold" />
                                    </FrameLayout>
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/textUvAdvice"
                                    style="@style/OnGlass.Secondary"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:lineSpacingExtra="2dp"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/textUvDetail"
                                    style="@style/OnGlass.Secondary"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:lineSpacingExtra="2dp"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <!-- Credit line. Required by the data source's terms. -->
                            <TextView
                                android:id="@+id/textUvSource"
                                style="@style/OnGlass.Secondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="?attr/selectableItemBackground"
                                android:minHeight="32dp"
                                android:gravity="center_vertical"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textAttribution"
                        style="@style/OnGlass.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textSize="11sp"
                        android:text="@string/attribution" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
