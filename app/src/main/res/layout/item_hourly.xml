<?xml version="1.0" encoding="utf-8"?>
<!-- Flat, fixed-size cell: cheap to inflate and rebind while scrolling.
     No horizontal padding on the root: the temperature line has to reach
     both edges so neighbouring cells join up. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="64dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/textHour"
        style="@style/OnGlass.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:maxLines="1"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/imageIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:contentDescription="@string/weather_icon" />

    <TextView
        android:id="@+id/textTemp"
        style="@style/OnGlass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:maxLines="1"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.vnweather.app.ui.main.TemperatureLineView
        android:id="@+id/tempLine"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/textRain"
        style="@style/OnGlass.Rain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:maxLines="1"
        android:gravity="center_vertical"
        android:drawableStart="@drawable/ic_drop_level_small"
        app:drawableTint="@color/rain_on_glass"
        android:drawablePadding="2dp"
        android:textSize="11sp" />
</LinearLayout>
